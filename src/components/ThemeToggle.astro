<label class="theme-control">
  <span class="sr-only">Color theme</span>
  <select id="theme-select" aria-label="Color theme">
    <option value="system">System</option>
    <option value="light">Light</option>
    <option value="dark">Dark</option>
  </select>
</label>
<style>
  .theme-control {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
  }
  .theme-control select {
    appearance: none;
    padding: 8px 34px 8px 12px;
    min-height: 36px;
    line-height: 1.2;
    cursor: pointer;
  }
  .theme-control::after {
    content: '';
    position: absolute;
    right: 14px;
    top: 50%;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
</style>
<script>
  const select = document.querySelector<HTMLSelectElement>('#theme-select');
  const media = matchMedia('(prefers-color-scheme: dark)');
  let preference = 'system';
  try { preference = localStorage.getItem('theme') || 'system'; } catch {}
  if (!['system', 'light', 'dark'].includes(preference)) preference = 'system';
  if (select) select.value = preference;
  function updateTheme() {
    document.documentElement.classList.toggle('dark', preference === 'dark' || (preference === 'system' && media.matches));
  }
  select?.addEventListener('change', () => {
    preference = select.value;
    try { localStorage.setItem('theme', preference); } catch {}
    updateTheme();
  });
  media.addEventListener('change', updateTheme);
  updateTheme();
</script>
